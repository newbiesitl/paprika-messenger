# Hosted values belong in Sites runtime settings, never in browser code.
# Trusted identity headers are supplied and protected by Sites dispatch.
OWNER_EMAIL=owner@example.com
COORDINATOR_EMAIL=owner@example.com
SITE_ORIGIN=https://your-private-board.chatgpt.site
# New setup selects this type for accounts without Dot or unknown availability.
PAPRIKA_SERVICE_TYPE=chatgpt-codex
# Accounts using Dot can choose dot-chatgpt-codex. An absent setting on an
# existing service preserves its Dot-compatible workflow. This is not an
# account entitlement or participant authentication setting.
# Optional stricter binding once the Site-scoped identity is known:
# OWNER_USER_ID=
# COORDINATOR_USER_ID=
# Optional subscribed events: see docs/SCHEDULING.md. Configure in Sites runtime.
# EVENT_SECRET_KEY=<base64-encoded random 32-byte AES-GCM runtime secret>
# EVENT_DISPATCH_PRIVATE_GATE=owner-private
# EVENT_DISPATCH_TOKEN_HASH=<digest of the existing Sites service token>
